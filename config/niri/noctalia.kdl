layout {

    focus-ring {
        active-color   "#a6c8ff"
        inactive-color "#111318"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a6c8ff"
        inactive-color "#111318"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a6c8ff"
        inactive-color "#224876"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a6c8ff80"
    }
}

recent-windows {
    highlight {
        active-color "#a6c8ff"
        urgent-color "#ffb4ab"
    }
}
